# ==============================================================================
# .geminiignore - Ignore patterns for Google Antigravity & Gemini Code Assist
# Helps save LLM context window tokens and prevents reading irrelevant files
# ==============================================================================

# Dependencies & Package Managers
node_modules/
package-lock.json
pnpm-lock.yaml
yarn.lock

# Build Outputs & Generated Artifacts
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts
.turbo/

# Large Binary Installers & Executables
*.exe
OllamaSetup.exe

# 3D Avatar Models & Heavy Assets (VRM, GLB, FBX)
public/models/
*.vrm
*.glb
*.gltf
*.fbx

# Media & Images (Token-heavy, non-code files)
public/*.jpg
public/*.jpeg
public/*.png
public/*.svg
public/*.ico
*.mp3
*.wav
*.ogg

# Environment & Sensitive Files
.env*
!.env.example

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*

# Legacy / Misleading Documentation (Preserves current architecture truth)
# Contains obsolete Python/FastAPI/Vite design that misleads AI:
interview_practice_requirements.md
# Legacy monolithic SQL dump (active migrations are in supabase/migrations/):
init_database.sql

# Git & OS Artifacts
.git/
.DS_Store
Thumbs.db

