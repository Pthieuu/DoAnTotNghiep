NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# For older projects, NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported.
# Use a publishable/anon key, never a secret/service_role key here.

# Server-only CV extraction. Ollama runs locally at no API charge.
CV_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Optional paid provider: set CV_AI_PROVIDER=openai to use OpenAI instead.
OPENAI_API_KEY=
OPENAI_CV_MODEL=gpt-4o-mini
# Optional; required for scanned PDFs without an embedded text layer.
GOOGLE_CLOUD_VISION_API_KEY=
